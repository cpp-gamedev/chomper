#pragma once
#include <klib/version_str.hpp>

namespace chomper {
inline constexpr auto buildVersion_v = klib::Version{
	.major = @PROJECT_VERSION_MAJOR@,
	.minor = @PROJECT_VERSION_MINOR@,
	.patch = @PROJECT_VERSION_PATCH@,
};

inline auto const buildVersionStr = std::format("{}", buildVersion_v);
} // namespace chomper
